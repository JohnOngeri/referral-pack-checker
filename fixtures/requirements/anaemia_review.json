{
  "type": "anaemia_review",
  "label": "Anaemia review",
  "note": "Illustrative requirement set authored for this project, structured after the kind of checklist an obstetric day unit works from. A real deployment would load the receiving facility's own documented requirements.",
  "fields": [
    { "field": "patientId", "label": "Patient identifier", "requirement": "mandatory" },
    { "field": "ageYears", "label": "Age", "requirement": "mandatory" },
    { "field": "lmp", "label": "Last menstrual period", "requirement": "mandatory" },
    { "field": "gestationalAge", "label": "Gestational age", "requirement": "mandatory" },
    { "field": "gravidity", "label": "Gravidity", "requirement": "mandatory" },
    { "field": "parity", "label": "Parity", "requirement": "mandatory" },
    { "field": "haemoglobin", "label": "Haemoglobin", "requirement": "mandatory", "maxAgeDays": 28 },
    { "field": "bloodGroup", "label": "Blood group", "requirement": "mandatory" },
    { "field": "rhesus", "label": "Rhesus status", "requirement": "mandatory" },
    { "field": "hivScreen", "label": "HIV screening status", "requirement": "mandatory", "maxAgeDays": 365 },
    { "field": "syphilisScreen", "label": "Syphilis screening status", "requirement": "mandatory", "maxAgeDays": 365 },
    { "field": "medications", "label": "Current medications", "requirement": "mandatory" },
    { "field": "reasonForReferral", "label": "Reason for referral", "requirement": "mandatory" },
    { "field": "referringFacility", "label": "Referring facility", "requirement": "mandatory" },
    { "field": "referringClinician", "label": "Referring clinician", "requirement": "mandatory" },
    { "field": "referralDate", "label": "Referral date", "requirement": "mandatory" },
    { "field": "receivingFacility", "label": "Receiving facility", "requirement": "mandatory" },
    {
      "field": "antiD",
      "label": "Anti-D immunoglobulin record",
      "requirement": "conditional",
      "condition": {
        "description": "Required when the rhesus status is recorded as negative.",
        "key": "rhesus_negative"
      }
    }
  ]
}
