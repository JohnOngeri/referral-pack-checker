# Copy to .env.local and fill in. .env.local is gitignored.
#
# Required for FRESH mode (real model calls in the extractor, summariser and baseline).
# REPLAY mode reads committed responses under results/raw/ and needs no key.
#
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash. The model used for a run is recorded in
# that run's raw request file under results/raw/.
MODEL_ID=gemini-3.6-flash
