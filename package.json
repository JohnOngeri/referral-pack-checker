{
  "name": "referral-pack-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Antenatal referral pack completeness and consistency checker. Checks documentation only; makes no clinical judgment.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx src/cli.ts check",
    "baseline": "tsx src/cli.ts baseline",
    "solve": "tsx src/cli.ts solve",
    "eval": "tsx src/cli.ts eval",
    "report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
